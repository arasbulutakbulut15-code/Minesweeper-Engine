{
  "name": "minesweeper-engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/render --noEmit && tsc -p packages/solver --noEmit && tsc -p packages/app --noEmit",
    "dev": "vite --config packages/app/vite.config.ts",
    "build": "vite build --config packages/app/vite.config.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}